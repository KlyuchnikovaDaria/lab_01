<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif SYSTEM "TBXcoreStructV02.dtd">
<martif type="TBX" xml:lang="en">
  <martifHeader>
    <fileDesc>
      <titleStmt>
        <title>Glossary EN-RU: Нефтегазовая отрасль: добыча и переработка</title>
      </titleStmt>
      <sourceDesc>
        <p>Lab 01, variant 25, generated automatically</p>
      </sourceDesc>
    </fileDesc>
    <encodingDesc>
      <p type="XCSURI">TBXXCSV02.xcs</p>
    </encodingDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="tid-001">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>amplitude</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Difference between the maximum displacement of a wave and the point of no displacement or the null point.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>амплитуда</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-002">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>aquifer</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Any water-bearing formation encountered while drilling.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>водоносный горизонт</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-003">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>appraisal</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The phase of petroleum operations that immediately follows successful exploratory drilling.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>оценка месторождения</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-004">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>air drilling</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Air drilling is a drilling technique whereby gases (typically compressed air or nitrogen) are used to cool the drill bit and lift cuttings out of the wellbore instead of the more conventional use of liquids.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>пневматическое бурение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-005">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>asphaltenes</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Asphaltenes are organic materials that contain aromatic and naphthenic ring compounds containing nitrogen, sulfur, and oxygen molecules.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>асфальтены</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-006">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>asphalt</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A solid or nearly solid form of bitumen that can melt upon heating and contains impurities such as nitrogen, oxygen, and sulfur.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>асфальт</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-007">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>bit</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The tool used to crush or cut rock.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>буровое долото</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-008">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>blowout</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An uncontrolled flow of reservoir fluids into the wellbore and sometimes catastrophically to the surface.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>выброс</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-009">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>blowout preventer (BOP)</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Equipment installed on the wellhead to prevent the escape of fluids under pressure from the wellbore during drilling, completion, or workover operations.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>противовыбросовый превентор (ПВО)</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-010">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>borehole</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The wellbore itself, including the open hole or uncased portion of the well.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>ствол скважины</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-011">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>beam pump</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An artificial lift pumping system using a surface power source to drive a downhole pump assembly.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>глубинный насос штангового типа</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-012">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>ball valve</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A valve that uses a spherical closure element (ball) that is rotated through 90° to open and close the valve.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>шаровой клапан</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-013">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>barrel (bbl)</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A measure of volume for petroleum products.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>баррель</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-014">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>burner</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A crucial piece of every oil or gas heating system, designed to heat air or water.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>горелка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-015">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>backpressure</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Pressure registered on equipment or devices when fluid flows through.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>противодавление</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-016">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>blinding</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A process that refers to the complete sealing off of any other refinery equipment by use of a metal plate that is appropriately designed so that it is crammed onto the end of a flanged vessel or pipe or even inserted between two flanges.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>установка заглушек</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-017">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>casing head</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The adapter between the first casing string and either the BOP stack (during drilling) or the wellhead (after completion).</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>обсадная головка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-018">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>christmas tree</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The set of valves, spools, and fittings connected to the top of a well to direct and control the flow of formation fluids from the well.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>фонтанное устьевое оборудование</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-019">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>compressibility</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The relative change in fluid volume related to a unit change in pressure.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>сжимаемость</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-020">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>cementing</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Permanently securing the casing to the wellbore or plugging and sealing the wellbore with cement.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>цементирование</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-021">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>choke</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A device incorporating an orifice that is used to control fluid flow rate or downstream system pressure.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>дроссельный вентиль</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-022">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>condensate</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A natural gas liquid with a lower vapor pressure than natural gasoline and liquefied petroleum gas.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>конденсат</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-023">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>condensate gas</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Hydrocarbon liquid dissolved in saturated natural gas that comes out of the solution when the pressure drops below the dewpoint.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>газовый конденсат</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-024">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>corrosion inhibitor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A chemical additive used in acid treatments to protect iron and steel components in the wellbore and treating equipment from the corrosive fluid.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>ингибитор коррозии</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-025">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>corrosion-resistant alloy</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A specially formulated material used for completion components in wells that is likely to present corrosion problems.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>коррозионностойкий сплав</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-026">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>density</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Degree of consistency measured by the quantity of mass per unit volume.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>плотность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-027">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>dehydrate</term>
            <termNote type="partOfSpeech">verb</termNote>
            <descrip type="definition">To remove water from a substance.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>обезвоживать</term>
              <termNote type="partOfSpeech">verb</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-028">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>demulsification</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A mixture of chemicals breaks the emulsion by destroying or weakening the stabilizing film around the dispersed drops.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>деэмульгация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-029">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>dense phase</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A state when fluid exists above both the cricondenbar pressure and the critical temperaturen.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>плотная фаза</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-030">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>derrick floor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The relatively small work area in which the rig crew conducts operations, usually adding or removing drillpipe to or from the drillstring.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>рабочая площадка буровой установки</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-031">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>desalter</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A device used in petroleum refineries to remove inorganic salts, water, and sediment from the incoming petroleum crude oil feedstock before it is refined.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>обессоливающая установка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-032">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>decompression</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A reduction in pressure; release from pressure or compression.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>декомпрессия</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-033">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>exploration</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The act of searching for the discovery of information or resources. Oil and gas exploration encompasses the processes and methods of locating potential oil and gas drilling and extraction sites.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>геологоразведочные работы</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-034">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>hydraulic fracturing</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The practice of pumping special fluids down the wellbore under high pressure.</descrip>
