            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A means of allowing a precise pressure differential before opening flow from the reservoir.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>азотная подушка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-069">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>centrifugal pump</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A type of pump commonly used in the handling and mixing oilfield fluids.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>центробежный насос</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-070">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>three-phase separator</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A vessel with cylindrical axes that separates oil, gas, and water from the production stream.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>трёхфазный сепаратор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-071">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>cold production</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Nonthermal primary heavy oil production methods that include horizontal wells, multilateral, CHOPS, and water or gas injection.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>холодная добыча</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-072">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>buster</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A simple separator vessel that removes free or entrained gas from fluids circulated in the wellbore.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>газосепаратор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-073">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>slam retarder</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A device to prevent the clapper of a check valve from slamming as it closes upon flow reversal.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>гаситель гидравлического удара</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-074">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>generator</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A device that creates electrical energy to power appliances running on electricity by burning the fuel it uses for producing electricity.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>генератор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-075">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>sealing</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The surface-to-surface joining technique of materials using a substance of a different type that adheres to the surfaces of the two adherents to be joined, transferring the forces from one adherent to the other.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>герметизация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-076">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>accumulator</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A vessel used in a hydraulic system to store energy or, in some applications, dampen pressure fluctuations.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>гидравлический аккумулятор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-077">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>downhole gauge</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A device used in assessing the downhole pressure under various flowing conditions, the basis of pressure transient analysis.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>глубинный манометр</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-078">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>archie rock</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A rock that is petrophysical simple.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>петрофизически простая горная порода</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-079">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>drilling rig</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A rig or drilling rig is a machine used to drill a wellbore.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>буровая установка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-080">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>drilling contractor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A drilling contractor is a company that owns and operates a drilling rig.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>буровой подрядчик</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-081">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>acid gas</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A gas that can form acidic solutions when mixed with water. Hydrogen sulfide (H2S) and carbon dioxide (CO2) are the most common acid gases.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>кислый газ</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-082">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>acetic acid</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An organic acid used in oil and gas well-stimulation treatments as an inhibit or retarder.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>уксусная кислота</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-083">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>acid inhibitor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A chemical additive used to protect wellbore components and treatment equipment from the corrosive action of an acid.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>кислотный ингибитор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-084">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>gas field</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A district where natural gas is produced in commercial quantities.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>газовое месторождение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-085">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>spacer fluid</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Any liquid used to separate one special-purpose liquid from another.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>буферная жидкость</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-086">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>crown valve</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The topmost valve on a Christmas tree that provides vertical access to the wellbore.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>буферная задвижка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-087">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>gross production</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The total production of oil, gas, or water from a well or field over a specific period of time.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>валовое производство</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-088">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>fan</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A machine used to move fluid or air.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>вентилятор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-089">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>duct</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A tube or passageway in a machine for air, liquid, cables, etc.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>воздуховод</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-090">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>wax</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A mixture of solid hydrocarbons.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>парафин; воск</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-091">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>well flow rate</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The well production or injection rate.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>дебит скважины</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-092">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>degasser</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A device that removes air or gases from drilling liquids.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>дегазатор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-093">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>gas blanket</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A gas phase maintained above a liquid in a vessel to protect the liquid against air contamination, to reduce the hazard of detonation, or to pressurize the liquid.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>газовая подушка; защитный газовый слой</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-094">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>butane</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">One of the lightest liquid streams typically produced in a refinery.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>бутан</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-095">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>tankage</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The capacity of all the tanks in a field.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>вместимость</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-096">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>pigging</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The act of forcing a device called a pig through a pipeline to displace or separate fluids and cleaning or inspecting the line.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>внутренняя очистка трубопровода скребками</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-097">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>air-powered</term>
            <termNote type="partOfSpeech">adjective</termNote>
            <descrip type="definition">Moved or worked by air pressure.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>с пневматическим приводом</term>
              <termNote type="partOfSpeech">adjective</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-098">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>roto-rabbit</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A small plug that is passed through a pressurized pressure line to clear the line or check for obstructions.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>вращающийся скребок</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-099">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>cap the well</term>
            <termNote type="partOfSpeech">verb</termNote>
            <descrip type="definition">Remain control of a blowout well by installing and closing a valve on the wellhead.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>закрывать; запечатывать; заглушать; ликвидировать скважину</term>
              <termNote type="partOfSpeech">verb</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-100">
        <descrip type="subjectField">Нефтегазовая отрасль: добыча и переработка</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>all-welded</term>
            <termNote type="partOfSpeech">adjective</termNote>
            <descrip type="definition">Completely welded and cannot be disassembled and repaired in the field.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>цельносварный</term>
              <termNote type="partOfSpeech">adjective</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
    </body>
  </text>
</martif>
